# Copy to .env and adjust. light_server.py does NOT auto-load this file;
# the systemd unit reads it via EnvironmentFile, or export it yourself:
#   set -a; . ./.env; set +a; python3 light_server.py

LIGHT_HOST=0.0.0.0
LIGHT_PORT=8000

# Must match API_TOKEN in the PC helper's .env. Leave blank to disable the check.
API_TOKEN=

# Seconds without an update before the LED goes dark (helper heartbeats every 10s).
STALE_AFTER=30

# BCM pin numbers wired to the R, G, B legs of the LED.
LED_PINS=17,27,22

# 1 = common-cathode LED (LED legs -> pins, common -> GND).
# 0 = common-anode LED (common -> 3V3, legs -> pins through resistors).
LED_ACTIVE_HIGH=1
