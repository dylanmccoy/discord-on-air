# Install on the Pi:
#   sudo cp pi-light.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now pi-light
# Edit the paths / User below to match your setup.

[Unit]
Description=Discord mute light HTTP -> LED bridge
After=network-online.target
Wants=network-online.target

[Service]
User=dylan
WorkingDirectory=/home/dylan/discord-on-air/pi-light
EnvironmentFile=/home/dylan/discord-on-air/pi-light/.env
ExecStart=/home/dylan/.local/bin/uv run --project /home/dylan/discord-on-air/pi-light light_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
