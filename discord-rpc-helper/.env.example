# From https://discord.com/developers/applications  ->  your application
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must be listed verbatim under OAuth2 -> Redirects for that application.
DISCORD_REDIRECT_URI=http://localhost

# Space/comma separated. "rpc" is enough; add "rpc.voice.read" only if Discord asks.
DISCORD_SCOPES=rpc

# --- Where to send state --------------------------------------------------
# Direct mode (recommended when the light only matters while this PC is on):
# POST straight to the pi-light listener on the Raspberry Pi.
INGEST_URL=http://raspberrypi.local:8000/
# ...or the ESP32-S2 light (esp32-light/): INGEST_URL=http://esp32-light:8000/

# Backend mode (use instead of INGEST_URL if you keep the Node backend/dashboard):
# BACKEND_URL=http://raspberrypi.local:3000     # helper appends /api/ingest/<your id>

# Shared secret. Must match API_TOKEN on whichever target you use above.
API_TOKEN=
